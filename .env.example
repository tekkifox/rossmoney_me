MONGODB_URI=mongodb://mongo:27017/rossmoney_me
PAYLOAD_SECRET=rossmoney_payload_secret_key_change_me
SERVER_URL=https://www.rossmoney.me
PAYLOAD_SEED=true

DOCKER_API_VERSION=v1.44
DOCKER_HOST=tcp://socket-proxy:2375
HOST_PROC=/host/proc
HOST_SYS=/host/sys
HOST_ROOT=/host/root

CONTAINERS=1
IMAGES=1
INFO=1
PING=1
POST=0
VERSION=1
LOG_LEVEL=info

# Trivy stack (docker-compose.trivy.yml)
# Optional: extra images for per-image HTML reports. Empty = daemon-discovered only.
TRIVY_SCAN_IMAGES=
TRIVY_SCAN_SEVERITY=HIGH,CRITICAL
TRIVY_SCAN_IGNORE_UNFIXED=true
# Space-separated host paths to skip during the OS scan (paths as seen inside the
# scan container, i.e. under /host). Large media mounts belong here.
TRIVY_SKIP_DIRS=
# Resource limits for the long-running trivy server (Compose v2 honours these).
TRIVY_CPUS=2.0
TRIVY_MEMORY=2G
# Resource limits for the one-shot `scan` job, which does the heaviest work.
TRIVY_SCAN_CPUS=2.0
TRIVY_SCAN_MEMORY=2G
