MONGODB_URI=mongodb://mongo:27017/rossmoney_me
PAYLOAD_SECRET=rossmoney_payload_secret_key_change_me
SERVER_URL=https://www.example.com
PAYLOAD_SEED=true
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

EMAIL_FROM=
EMAIL_FROM_NAME="Ross Money Website Contact Form"
RESEND_API_KEY=

# Optional: only set on Vercel deployments to store media in Vercel Blob.
# When unset, uploads stay on the local filesystem (public/media), which is what
# the self-hosted Portainer stack uses. Leave it unset there.
# BLOB_READ_WRITE_TOKEN=

# ArchView is a separate deployment at https://archview.example.com with
# OAuth enabled. The CMS talks to it server-side only (the /api/architecture
# proxy and the architecture templates), so it exchanges Auth0 client
# credentials for a short-lived bearer token. At seed time these values also
# create the default "Production" ArchView source. ARCHVIEW_URL is only the
# bootstrap fallback until a default source exists. Leave the client credentials
# unset for local development against ArchView's AUTH_MODE=none.
ARCHVIEW_URL=https://archview.example.com
ARCHVIEW_CLIENT_ID=your-archview-client-id
ARCHVIEW_CLIENT_SECRET=your-archview-client-secret
ARCHVIEW_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
ARCHVIEW_AUDIENCE=https://archview.example.com/api
ARCHVIEW_SCOPE=archview:read
# Optional comma-separated HTTPS origins for pages that point at an ArchView
# other than this deployment's (e.g. the game-servers page). These origins are
# called anonymously: they are not authenticated by the CMS.
ARCHVIEW_ALLOWED_SOURCES=
# Optional upstream fetch budget (ms) for /api/architecture; default 15000, max 60000.
ARCHVIEW_TIMEOUT_MS=15000
# Encrypts client secrets stored in the ArchView sources collection. 32 random
# bytes, base64: generate with `openssl rand -base64 32`. Changing it makes
# existing stored secrets unreadable, so set it before adding sources.
ARCHVIEW_SECRET_KEY=

# Host sampling runs on exactly one deployment and is the only writer of
# host-samples: one sample per enabled source every three minutes. Page views
# do not add samples. HOST_SAMPLER_INSTANCE is this
# deployment's own short name; HOST_SAMPLER_OWNER is the name of the one
# deployment allowed to sample. Set the same owner on every deployment and a
# different instance on each. An owner set without an instance means nobody
# samples. HOST_SAMPLER=on forces sampling (Vercel included) and
# HOST_SAMPLER=off disables it everywhere; with neither set, sampling follows
# the old behaviour (off on Vercel, on elsewhere). Empty values count as unset.
# Example: HOST_SAMPLER_OWNER=portainer on both deployments,
# HOST_SAMPLER_INSTANCE=portainer on the host and =vercel on Vercel: only the
# host samples. Flip the owner to vercel to move sampling there.
HOST_SAMPLER_INSTANCE=
HOST_SAMPLER_OWNER=
