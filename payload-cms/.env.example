# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# SMTP transport used by the Payload contact form
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=dev@rossmoney.me
SMTP_FROM_NAME=Ross Money
SMTP_SECURE=false

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ArchView API (separate stack at https://archview.rossmoney.me, OAuth enabled).
# The CMS server authenticates with a static key from that stack's API_KEYS.
ARCHVIEW_URL=https://archview.rossmoney.me
ARCHVIEW_API_KEY=your-archview-api-key
