# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# SMTP transport used by the Payload contact form
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=dev@rossmoney.me
SMTP_FROM_NAME=Ross Money
SMTP_SECURE=false

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ArchView (separate deployment at https://archview.rossmoney.me).
# The CMS server exchanges these Auth0 client credentials for a short-lived
# bearer token. Leave the client credentials unset for local development
# against ArchView's AUTH_MODE=none.
ARCHVIEW_URL=https://archview.rossmoney.me
ARCHVIEW_CLIENT_ID=cms
ARCHVIEW_CLIENT_SECRET=your-archview-client-secret
ARCHVIEW_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
ARCHVIEW_AUDIENCE=https://archview.rossmoney.me/api
ARCHVIEW_SCOPE=archview:read
# Optional comma-separated HTTPS origins for pages that point at an ArchView
# other than this deployment's (e.g. the game-servers page).
ARCHVIEW_ALLOWED_SOURCES=
