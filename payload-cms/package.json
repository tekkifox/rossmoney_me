{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "audit:prod": "node ./scripts/audit-production.mjs",
    "backfill:cv-html": "cross-env NODE_OPTIONS=--no-deprecation tsx ./scripts/backfill-cv-html.ts",
    "backfill:page-templates": "cross-env NODE_OPTIONS=--no-deprecation tsx ./scripts/backfill-page-templates.ts",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "generate:sitemap": "tsx ./scripts/generate-sitemap.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:tokens": "node ./scripts/check-tokens.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "screenshots": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.screenshots.ts",
    "screenshots:publish": "cross-env NODE_OPTIONS=--no-deprecation tsx ./scripts/publish-screenshots.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:loopback": "cross-env NODE_OPTIONS=--no-deprecation next start -H 127.0.0.1",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "unpublish:retired-pages": "cross-env NODE_OPTIONS=--no-deprecation tsx ./scripts/unpublish-retired-pages.ts",
    "verify:rate-limit": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx ./scripts/verify-shared-rate-limit.mts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.93.0",
    "@payloadcms/db-mongodb": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.9",
    "geist": "^1.9.2",
    "graphql": "^17.1.0",
    "lucide-react": "1.69.0",
    "mammoth": "^1.13.0",
    "mongodb": "7.8.0",
    "next": "16.4.5",
    "next-sitemap": "^4.2.3",
    "payload": "3.93.0",
    "pdfjs-dist": "6.5.438",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "^10.6.2",
    "jsdom": "31.0.0",
    "oxlint": "1.91.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11 || ^12.0.0"
  }
}
