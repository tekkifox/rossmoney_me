#!/bin/sh
# Render a Lynis screen log as a standalone HTML report.
#
# Lynis ships no HTML formatter; upstream suggests piping through ansi2html, but
# that is not packaged for Alpine stable. This does the same job with sed: the log
# is generated with --no-colors, so there are no escape sequences to translate and
# the output is deterministic.
#
#   lynis-html <logfile> <outfile> <title>

set -eu

log="${1:?log file}"
out="${2:?output file}"
title="${3:-Lynis security audit}"

[ -f "$log" ] || { echo "no log at $log" >&2; exit 1; }

# Lynis prefixes its findings with [!] for warnings and [x] for suggestions, and
# prints the hardening score as a bare integer. Colour each class rather than
# matching on arbitrary text.
esc() { sed "s/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g"; }

body="$(esc < "$log" | sed \
    -e 's/^\(\[!\]\)/<span class="warn">\1<\/span>/' \
    -e 's/^\(\[x\]\)/<span class="sug">\1<\/span>/' \
    -e 's/^\(\[.\]\)/<span class="ok">\1<\/span>/' \
    -e 's/^\([-*]\)/<span class="step">\1<\/span>/')"

cat > "$out" <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>$title</title>
<style>
  :root { color-scheme: light dark; }
  body {
    margin: 0; padding: 2rem;
    font: 14px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: #12141a; color: #d8dce6;
  }
  h1 { font-size: 1.25rem; margin: 0 0 1rem; font-weight: 600; }
  pre {
    margin: 0; padding: 1.25rem;
    background: #191c24; border: 1px solid #262b36; border-radius: 6px;
    overflow-x: auto; white-space: pre-wrap; word-break: break-word;
  }
  .warn  { color: #ffb454; }
  .sug   { color: #6fb3ff; }
  .ok    { color: #7ee787; }
  .step  { color: #9aa4b8; }
  footer { margin-top: 1rem; color: #6b7280; font-size: 12px; }
</style>
</head>
<body>
<h1>$title</h1>
<pre>$body</pre>
<footer>Generated from lynis.log by lynis-html. No-store: reports are rewritten on every audit.</footer>
</body>
</html>
HTML

echo "wrote $out"
