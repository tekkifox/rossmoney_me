{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/London",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["@payloadcms/**", "payload"],
      "groupName": "Payload",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchPackageNames": ["next"],
      "groupName": "Next.js",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "groupName": "toolchain",
      "matchPackageNames": ["node", "pnpm", "corepack", "mongo"],
      "matchDatasources": ["docker", "npm"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ]
}
