{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "public/sitemap.xml", "public/robots.txt"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "tags": ["ci"]
    },
    "test:int": {
      "tags": ["ci"]
    }
  }
}
